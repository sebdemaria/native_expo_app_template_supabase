        "react-native-purchases-ui": "^10.12.2",
        "react-native-reanimated": "4.5.1",
        "react-native-safe-area-context": "~5.7.0",
        "react-native-screens": "~4.26.0",
        "react-native-url-polyfill": "^4.0.0",
        "react-native-web": "~0.21.0",
        "react-native-worklets": "0.10.1",
        "zod": "^4.6.5",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@babel/core": "^7.29.0",
        "@commitlint/cli": "20.2.0",
        "@commitlint/config-conventional": "20.2.0",
        "@eslint/js": "9.39.5",
        "@react-native/jest-preset": "0.86.3",
        "@testing-library/react-native": "^14.1.0",
        "@types/jest": "29.5.14",
        "@types/node": "^22",
        "@types/react": "~19.2.2",
        "@typescript-eslint/parser": "^8.71.1",
        "ajv": "8.20.0",
        "babel-preset-expo": "^57.0.14",
        "eslint": "9.39.5",
        "eslint-config-expo": "^57.0.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-simple-import-sort": "^13.0.0",
        "expo-doctor": "^1.20.4",
        "husky": "9.1.7",
        "jest": "~29.7.0",
        "jest-expo": "~57.0.5",
        "lint-staged": "16.2.7",
        "prettier": "^3.9.9",
        "prettier-plugin-tailwindcss": "^0.5.11",
        "supabase": "^2.120.0",
        "tailwindcss": "^3.4.17",
        "test-renderer": "1.1.0",
        "typescript": "~6.0.3"
    },
    "scripts": {
        "start": "expo start",
        "android": "expo run:android",
        "ios": "expo run:ios",
        "ios:simulator": "expo start --dev-client --localhost --ios",
        "ios:prebuild": "expo prebuild --clean --platform ios",
        "web": "expo start --web",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint:all": "yarn lint:fix && yarn format",
        "typecheck": "tsc --noEmit",
        "test": "jest --passWithNoTests",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage --passWithNoTests",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "yarn lint && yarn typecheck && yarn format:check && yarn test",
        "doctor": "expo-doctor",
        "build:check": "expo export --platform all --output-dir dist --clear",
        "supabase:start": "supabase start",
        "supabase:stop": "supabase stop",
        "supabase:reset": "supabase db reset",
        "supabase:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{js,jsx,cjs,mjs,ts,tsx}": [
            "eslint --fix --no-warn-ignored",
            "prettier --write"
        ],
        "*.{json,jsonc,md,css,yml,yaml}": [
            "prettier --write"
        ]
    },
    "private": true
}
