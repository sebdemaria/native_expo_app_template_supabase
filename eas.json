{
    "cli": {
        "version": ">= 18.4.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "environment": "development",
            "env": { "APP_ENV": "development" }
        },
        "ios-simulator": {
            "extends": "development",
            "ios": { "simulator": true }
        },
        "preview": {
            "distribution": "internal",
            "android": { "buildType": "apk" },
            "environment": "preview",
            "env": { "APP_ENV": "preview" }
        },
        "production": {
            "autoIncrement": true,
            "environment": "production",
            "env": { "APP_ENV": "production" }
        }
    },
    "submit": {
        "production": {
            "android": { "track": "internal" },
            "ios": {}
        }
    }
}
